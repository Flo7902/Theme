// ============================================================================
//  CrimsonMoon V3.2  –  ORGANIZED + COMMENTED VERSION (for editing only)
//  Install the comment-free file CrimsonMoonV3.2.json instead; Discord mods can't read comments.
//
//  semanticColors = color per FUNCTION, format ["dark", "light"]  (wins over rawColors)
//  rawColors      = color per PALETTE STEP (many places share them)
//  Each semantic line shows the original Discord default after "default:".
//  Accent: #FF5050 (light red), pressed: #E04040, soft: #FF505033 (alpha).
// ============================================================================
{
  "name": "CrimsonMoon V3",
  "description": "Red theme (converted from Reseam)",
  "authors": [{ "name": "SryFlo", "id": "260439195451916299" }],
  "spec": 2,
  "background": {"url": "https://i.imgur.com/lrVCj59.png", "blur": 0, "alpha": 0.6},

  "semanticColors": {

    // ---------- CHAT INPUT / MESSAGE BOX ----------
    "CHAT_INPUT_ICON_DEFAULT_TINT": ["#FF5050", "#FF5050"],  // default: #b5bac1
    "CHAT_INPUT_SEND_BUTTON_ACTIVE_BACKGROUND": ["#FF5050", "#FF5050"],  // send button background; default: #5865f2
    "CHAT_INPUT_ACTION_BUTTON_ICON_DEFAULT_TINT": ["#FF5050", "#FF5050"],  // default: #dbdee1
    "CHAT_INPUT_ACTION_ICON_ACTIVE_TINT": ["#FF8983", "#FF8983"],  // chat input icons while pressed; default: #949cf7

    // ---------- SWITCHES, CHECKBOXES & INPUT CONTROLS ----------
    "REDESIGN_INPUT_CONTROL_SELECTED": ["#FF5050", "#FF5050"],  // default: #5865f2
    "SWITCH_BACKGROUND_SELECTED_DEFAULT": ["#FF5050", "#FF5050"],  // switch track when ON; default: #5865f2
